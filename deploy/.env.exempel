# Kopiera till .env i samma katalog och fyll i pa varden. .env committas aldrig.
# Inga varden och inga sokvagar star i den har filen - bara vad som ska finnas.

# Vardens katalog med repoklonen. Monteras pa /srv/repo: skrivskyddat i kedja,
# skrivbart i uppdatera. Absolut sokvag, eller relativ till den har katalogen.
REPO_DIR=

# Vardens katalog som ar dataarkivet. Monteras skrivbart pa /srv/data i kedja,
# och STATES_DATA pekar dit. Absolut, eller relativ till den har katalogen.
DATA_DIR=

# uid och gid for den egna anvandaren pa varden som kedjan kor som. Anvandaren
# ska ha las- och skrivratt enbart pa kedjans mapp, ingen hemkatalog och ingen
# inloggning. Repot och datan ska agas av den.
KEDJA_UID=
KEDJA_GID=

# Nyckel till klassificeraren. Lamnas tom pa en vard som bara kor bevisfangsten.
ANTHROPIC_API_KEY=
